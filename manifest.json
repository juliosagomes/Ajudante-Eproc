{
  "manifest_version": 3,
  "name": "Ajudante +Eproc",
  "version": "2.3.0",
  "description": "Assistente modular para o Eproc. Ative ou desative funcionalidades nas configurações.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings/settings.html",
  "content_scripts": [
    {
      "matches": ["*://*.jus.br/*"],
      "js": [
        "content.js",
        "lib/modal-manager.js",
        "lib/alertas.js",
        "modules/anotacoes-preferencias/anotacoes-preferencias.js",
        "modules/colorir-localizadores/colorir-localizadores.js",
        "modules/filtros-eventos/filtros-eventos.js",
        "modules/expansor-numero-processo/expansor-numero-processo.js",
        "modules/busca-inteligente/busca-inteligente.js",
        "modules/pagina-processo-plus/pagina-processo-plus.js",
        "modules/pagina-processo-plus/filtro-preferencias/filtro-preferencias.js",
        "scripts/localizador-busca/localizador-busca.js",
        "scripts/informacoes-adicionais/informacoes-adicionais.js",
        "scripts/tarjas-customizadas/tarjas-customizadas.js",
        "scripts/esmaecer-zerados/esmaecer-zerados.js",
        "scripts/painel-reordenar/painel-reordenar.js",
        "scripts/painel-acoes/painel-acoes.js",
        "scripts/historico-localizadores/historico-localizadores.js"
      ],
      "css": [
        "styles.css",
        "modules/anotacoes-preferencias/anotacoes-preferencias.css",
        "modules/colorir-localizadores/colorir-localizadores.css",
        "modules/filtros-eventos/filtros-eventos.css",
        "modules/expansor-numero-processo/expansor-numero-processo.css",
        "modules/busca-inteligente/busca-inteligente.css",
        "modules/pagina-processo-plus/pagina-processo-plus.css",
        "modules/pagina-processo-plus/filtro-preferencias/filtro-preferencias.css",
        "scripts/localizador-busca/localizador-busca.css",
        "scripts/tarjas-customizadas/tarjas-customizadas.css",
        "scripts/painel-reordenar/painel-reordenar.css",
        "scripts/painel-acoes/painel-acoes.css",
        "scripts/historico-localizadores/historico-localizadores.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.jus.br/*controlador.php*"],
      "js": ["modules/gerar-ficha/gerar-ficha.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/qrcode.min.js"],
      "matches": ["*://*.jus.br/*"]
    }
  ],
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.jus.br/*"]
}
